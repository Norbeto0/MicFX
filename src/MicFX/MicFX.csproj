<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <!-- WinForms is referenced only for NotifyIcon (system tray). -->
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon>Assets/micfx.ico</ApplicationIcon>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>MicFX</AssemblyName>
    <RootNamespace>MicFX</RootNamespace>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Version>1.8.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="NAudio" Version="2.2.1" />
  </ItemGroup>

  <ItemGroup>
    <!-- Keep the WinForms implicit usings out of the WPF code (Button/MessageBox/etc. would clash). -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets/micfx.ico" />
  </ItemGroup>

  <ItemGroup>
    <!-- Built from pinned xiph/rnnoise source by the release workflow and
         embedded, because every distribution form (single-file exe, installer)
         ships MicFX.exe alone — a loose DLL beside it would not travel.
         NativeLibraryLoader unpacks it at runtime. Local builds without the
         file fall back to the spectral suppressor. -->
    <EmbeddedResource Include="native/rnnoise.dll" Condition="Exists('native/rnnoise.dll')"
                      LogicalName="MicFX.rnnoise.dll" />
  </ItemGroup>

</Project>
