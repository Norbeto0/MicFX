<Window x:Class="MicFX.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MicFX — Mic Effects Station"
        Height="760" Width="1180"
        MinHeight="600" MinWidth="1020"
        Background="{StaticResource WindowBrush}"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <DockPanel Grid.Row="0" Margin="0,0,0,10">
            <ToggleButton x:Name="btnMenu" DockPanel.Dock="Left" Content="☰"
                          Width="38" Height="34" FontSize="17" VerticalAlignment="Center"
                          Margin="0,0,12,0" ToolTip="Settings">
                <ToggleButton.Template>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bd" Background="{StaticResource PanelBrush}"
                                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource HoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentDimBrush}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </ToggleButton.Template>
            </ToggleButton>

            <!-- Settings flyout -->
            <Popup PlacementTarget="{Binding ElementName=btnMenu}" Placement="Bottom"
                   StaysOpen="False" AllowsTransparency="True"
                   IsOpen="{Binding IsChecked, ElementName=btnMenu, Mode=TwoWay}">
                <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1" CornerRadius="6" Margin="0,4,0,0" Width="290">
                    <StackPanel Margin="14">
                        <TextBlock Text="SETTINGS" FontWeight="SemiBold"
                                   Foreground="{StaticResource SubtleTextBrush}" Margin="0,0,0,10"/>
                        <CheckBox x:Name="chkShowEffects" Content="Show voice effects panel"
                                  Checked="ShowEffects_Changed" Unchecked="ShowEffects_Changed"
                                  ToolTip="Hiding the panel also switches the effect back to None"/>
                        <CheckBox x:Name="chkRunOnBoot" Content="Run on Windows startup" Margin="0,10,0,0"
                                  Checked="RunOnBoot_Changed" Unchecked="RunOnBoot_Changed"/>
                        <TextBlock Text="Closing the window minimizes MicFX to the tray — exit via the tray icon."
                                   FontSize="11" Foreground="{StaticResource SubtleTextBrush}"
                                   TextWrapping="Wrap" Margin="0,10,0,0"/>
                    </StackPanel>
                </Border>
            </Popup>

            <Button x:Name="btnStartStop" DockPanel.Dock="Right" Width="110"
                    Style="{StaticResource AccentButton}" Content="Start"
                    Click="StartStop_Click"/>
            <TextBlock Text="MicFX" FontSize="22" FontWeight="Bold" VerticalAlignment="Center"/>
            <TextBlock Text="Profile" VerticalAlignment="Center" Margin="18,0,6,0" FontSize="11"
                       Foreground="{StaticResource SubtleTextBrush}"/>
            <ComboBox x:Name="comboProfile" Width="130" VerticalAlignment="Center"
                      SelectionChanged="Profile_Changed"/>
            <Button Content="Save" Margin="6,0,0,0" Padding="8,3" VerticalAlignment="Center"
                    Click="SaveProfile_Click" ToolTip="Save current settings into the selected profile"/>
            <Button Content="New" Margin="4,0,0,0" Padding="8,3" VerticalAlignment="Center"
                    Click="NewProfile_Click" ToolTip="Create a new profile from the current settings"/>
            <Button Content="Del" Margin="4,0,0,0" Padding="8,3" VerticalAlignment="Center"
                    Click="DeleteProfile_Click" ToolTip="Delete the selected profile"/>
            <TextBlock x:Name="txtStatus" Text="Stopped" Margin="16,0,12,0"
                       VerticalAlignment="Center" Foreground="{StaticResource SubtleTextBrush}"
                       TextTrimming="CharacterEllipsis"/>
        </DockPanel>

        <!-- Notice bar (VB-Cable setup, updates) -->
        <Border x:Name="noticeBar" Grid.Row="1" Visibility="Collapsed"
                Background="{StaticResource AccentDimBrush}" CornerRadius="6"
                Padding="10,8" Margin="0,0,0,10">
            <DockPanel>
                <Button x:Name="btnNoticeClose" DockPanel.Dock="Right" Content="✕"
                        Padding="6,2" Click="NoticeClose_Click"/>
                <Button x:Name="btnNoticeSecondary" DockPanel.Dock="Right" Margin="8,0"
                        Click="NoticeSecondary_Click"/>
                <Button x:Name="btnNoticeAction" DockPanel.Dock="Right" Margin="8,0,0,0"
                        Click="NoticeAction_Click"/>
                <TextBlock x:Name="txtNotice" VerticalAlignment="Center" TextWrapping="Wrap"/>
            </DockPanel>
        </Border>

        <!-- Main area: left controls · voice effects · equalizer · soundboard, all parallel -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*" MinWidth="260"/>
                <ColumnDefinition Width="300"/>
            </Grid.ColumnDefinitions>

            <!-- Devices, levels, clean-up (no scroll — fills the column) -->
            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                <GroupBox Header="DEVICES">
                    <StackPanel>
                        <TextBlock Text="Microphone" FontSize="11" Foreground="{StaticResource SubtleTextBrush}"/>
                        <ComboBox x:Name="comboMic" Margin="0,2,0,8" SelectionChanged="Device_SelectionChanged"/>
                        <TextBlock Text="Output (your virtual cable, e.g. CABLE Input)" FontSize="11"
                                   Foreground="{StaticResource SubtleTextBrush}"/>
                        <ComboBox x:Name="comboOutput" Margin="0,2,0,8" SelectionChanged="Device_SelectionChanged"/>
                        <TextBlock Text="Monitor (your headphones)" FontSize="11"
                                   Foreground="{StaticResource SubtleTextBrush}"/>
                        <ComboBox x:Name="comboMonitor" Margin="0,2,0,8" SelectionChanged="Monitor_Changed"/>
                        <DockPanel>
                            <Button Content="Refresh" DockPanel.Dock="Right" Click="RefreshDevices_Click"/>
                            <CheckBox x:Name="chkMonitor" Content="Listen to myself"
                                      Checked="Monitor_Changed" Unchecked="Monitor_Changed"/>
                        </DockPanel>
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="LEVELS">
                    <StackPanel>
                        <DockPanel>
                            <TextBlock x:Name="lblMicGain" DockPanel.Dock="Right" Text="100%" FontSize="11"
                                       Foreground="{StaticResource SubtleTextBrush}"/>
                            <TextBlock Text="Mic gain" FontSize="11" Foreground="{StaticResource SubtleTextBrush}"/>
                        </DockPanel>
                        <Slider x:Name="sliderMicGain" Minimum="0" Maximum="2" Value="1"
                                ValueChanged="MicGain_Changed" Margin="0,2,0,6"/>
                        <TextBlock Text="Input" FontSize="11" Foreground="{StaticResource SubtleTextBrush}"/>
                        <ProgressBar x:Name="meterIn" Minimum="0" Maximum="100" Margin="0,2,0,6"/>
                        <TextBlock Text="Output" FontSize="11" Foreground="{StaticResource SubtleTextBrush}"/>
                        <ProgressBar x:Name="meterOut" Minimum="0" Maximum="100" Margin="0,2,0,8"/>
                        <DockPanel>
                            <TextBlock x:Name="lblMaster" DockPanel.Dock="Right" Text="100%" FontSize="11"
                                       Foreground="{StaticResource SubtleTextBrush}"/>
                            <TextBlock Text="Output volume" FontSize="11" Foreground="{StaticResource SubtleTextBrush}"/>
                        </DockPanel>
                        <Slider x:Name="sliderMaster" Minimum="0" Maximum="2" Value="1"
                                ValueChanged="Master_Changed" Margin="0,2,0,0"/>
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="CLEAN-UP">
                    <StackPanel>
                        <DockPanel>
                            <TextBlock x:Name="lblDenoise" DockPanel.Dock="Right" Text="18 dB" FontSize="11"
                                       Foreground="{StaticResource SubtleTextBrush}"/>
                            <CheckBox x:Name="chkDenoise" Content="Noise suppression"
                                      Checked="Denoise_Changed" Unchecked="Denoise_Changed"
                                      ToolTip="Removes steady background noise (fans, hum, AC) while you talk"/>
                        </DockPanel>
                        <Slider x:Name="sliderDenoise" Minimum="6" Maximum="30" Value="18"
                                ValueChanged="Denoise_Changed" Margin="0,2,0,8"/>
                        <DockPanel>
                            <TextBlock x:Name="lblGate" DockPanel.Dock="Right" Text="-45 dB" FontSize="11"
                                       Foreground="{StaticResource SubtleTextBrush}"/>
                            <CheckBox x:Name="chkGate" Content="Noise gate"
                                      Checked="Gate_Changed" Unchecked="Gate_Changed"
                                      ToolTip="Mutes the mic entirely when you're not speaking"/>
                        </DockPanel>
                        <Slider x:Name="sliderGate" Minimum="-80" Maximum="-20" Value="-45"
                                ValueChanged="Gate_Changed" Margin="0,2,0,8"/>
                        <DockPanel>
                            <TextBlock x:Name="lblComp" DockPanel.Dock="Right" Text="50" FontSize="11"
                                       Foreground="{StaticResource SubtleTextBrush}"/>
                            <CheckBox x:Name="chkComp" Content="Voice leveler"
                                      Checked="Comp_Changed" Unchecked="Comp_Changed"
                                      ToolTip="Compressor: evens out quiet and loud speech, broadcast-style"/>
                        </DockPanel>
                        <Slider x:Name="sliderComp" Minimum="0" Maximum="100" Value="50"
                                ValueChanged="Comp_Changed" Margin="0,2,0,0"/>
                    </StackPanel>
                </GroupBox>
            </StackPanel>

            <!-- Voice effects (hidden by default — toggle in the menu) -->
            <GroupBox x:Name="effectsPanel" Grid.Column="1" Header="VOICE EFFECT"
                      Width="230" Margin="0,0,10,0" Visibility="Collapsed">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                        <DockPanel>
                            <TextBlock x:Name="lblIntensity" DockPanel.Dock="Right" Text="50" FontSize="11"
                                       Foreground="{StaticResource SubtleTextBrush}"/>
                            <TextBlock Text="Intensity" FontSize="11" Foreground="{StaticResource SubtleTextBrush}"/>
                        </DockPanel>
                        <Slider x:Name="sliderIntensity" Minimum="0" Maximum="100" Value="50"
                                ValueChanged="Intensity_Changed" Margin="0,2,0,0"/>
                    </StackPanel>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ListBox x:Name="lstEffects" SelectionChanged="Effect_Changed">
                            <ListBoxItem Content="None" Tag="None" IsSelected="True"/>
                            <ListBoxItem Content="🤖  Robot" Tag="Robot"/>
                            <ListBoxItem Content="👩  Female" Tag="Female"/>
                            <ListBoxItem Content="🎙  Deep Male" Tag="Deep"/>
                            <ListBoxItem Content="🐿  Chipmunk" Tag="Chipmunk"/>
                            <ListBoxItem Content="🕳  Cave Echo" Tag="Cave"/>
                            <ListBoxItem Content="📢  Megaphone" Tag="Megaphone"/>
                            <ListBoxItem Content="👽  Alien" Tag="Alien"/>
                            <ListBoxItem Content="🤫  Whisper" Tag="Whisper"/>
                            <ListBoxItem Content="👻  Ghost" Tag="Ghost"/>
                        </ListBox>
                    </ScrollViewer>
                </DockPanel>
            </GroupBox>

            <!-- Equalizer with spectrum behind it -->
            <GroupBox Grid.Column="2" Header="EQUALIZER" Margin="0,0,10,0">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                        <Button Content="Reset" DockPanel.Dock="Right" Click="EqReset_Click"/>
                        <ComboBox x:Name="comboEqPreset" Width="180" HorizontalAlignment="Left"
                                  SelectionChanged="EqPreset_Changed"/>
                    </DockPanel>
                    <Grid>
                        <UniformGrid x:Name="spectrumPanel" Rows="1" Margin="6,16,6,20"/>
                        <UniformGrid x:Name="eqPanel" Rows="1"/>
                    </Grid>
                </DockPanel>
            </GroupBox>

            <!-- Soundboard (narrow column, parallel to the EQ) -->
            <GroupBox Grid.Column="3" Header="SOUNDBOARD">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                        <DockPanel>
                            <Button Content="⏹ Stop all" DockPanel.Dock="Right" Click="StopAll_Click"/>
                            <Button Content="＋ Add sound…" HorizontalAlignment="Left" Click="AddSound_Click"/>
                        </DockPanel>
                        <DockPanel Margin="0,8,0,0">
                            <TextBlock Text="Volume" DockPanel.Dock="Left" VerticalAlignment="Center"
                                       Margin="0,0,8,0" FontSize="11" Foreground="{StaticResource SubtleTextBrush}"/>
                            <Slider x:Name="sliderSoundVol" Minimum="0" Maximum="1" Value="0.8"
                                    VerticalAlignment="Center" ValueChanged="SoundVol_Changed"/>
                        </DockPanel>
                        <TextBlock Text="Hotkeys Ctrl+Alt+1…9 (customizable) · right-click a tile to edit or remove"
                                   FontSize="11" Foreground="{StaticResource SubtleTextBrush}"
                                   TextWrapping="Wrap" Margin="0,6,0,0"/>
                    </StackPanel>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="icSounds">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Width="128" Height="62" Margin="4"
                                            Click="SoundTile_Click" Tag="{Binding}">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"
                                                       TextAlignment="Center" MaxWidth="112"/>
                                            <TextBlock Text="{Binding StatusLabel}" FontSize="10" TextAlignment="Center"
                                                       Foreground="{StaticResource SubtleTextBrush}"/>
                                        </StackPanel>
                                        <Button.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem Header="Edit…" Click="EditSound_Click" Tag="{Binding}"/>
                                                <MenuItem Header="Remove" Click="RemoveSound_Click" Tag="{Binding}"/>
                                            </ContextMenu>
                                        </Button.ContextMenu>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </GroupBox>
        </Grid>
    </Grid>
</Window>
